{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "incident-zero/diagnosis.provisional.json",
  "title": "Incident diagnosis (PROVISIONAL - replace with the organisers' schema verbatim)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "incident_id",
    "generated_at",
    "alert",
    "status",
    "root_cause",
    "confidence",
    "confidence_label",
    "evidence",
    "proposed_action",
    "investigation"
  ],
  "properties": {
    "incident_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "alert": {"type": "string"},
    "status": {
      "description": "diagnosed = evidence converges on one component; escalated = not confident, findings handed to a human",
      "enum": ["diagnosed", "escalated"]
    },
    "root_cause": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service", "fault_type", "summary"],
      "properties": {
        "service": {"type": ["string", "null"], "description": "The failing component, not the symptom service. null only when escalated."},
        "fault_type": {
          "enum": [
            "application_error",
            "dependency_unreachable",
            "service_down",
            "restart_loop",
            "resource_exhaustion",
            "latency",
            "traffic_surge",
            "queue_backlog",
            "unknown"
          ]
        },
        "summary": {"type": "string", "minLength": 10}
      }
    },
    "symptom_services": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Services that showed errors/latency only because they call the root cause."
    },
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "confidence_label": {"enum": ["high", "medium", "low"]},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence_item"}
    },
    "proposed_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "target", "reason", "requires_approval"],
      "properties": {
        "action": {
          "description": "Only remedies the Action API allows (Day 2). escalate_to_human when not confident.",
          "enum": ["restart_service", "toggle_feature_flag", "throttle_load", "scale_service", "escalate_to_human"]
        },
        "target": {"type": ["string", "null"]},
        "reason": {"type": "string"},
        "requires_approval": {"const": true}
      }
    },
    "investigation": {
      "type": "object",
      "required": ["tool_calls", "tools_used", "model"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "tools_used": {"type": "array", "items": {"type": "string"}},
        "model": {"type": "string"},
        "duration_seconds": {"type": "number"},
        "calibration_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "timeline": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "event"],
        "properties": {"time": {"type": "string"}, "event": {"type": "string"}}
      }
    },
    "prevention": {"type": "string"}
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "required": ["reference", "kind", "service"],
      "properties": {
        "reference": {"type": "string", "pattern": "^(trace|log|metric)-[0-9]+$"},
        "kind": {"enum": ["trace", "log", "metric"]},
        "service": {"type": ["string", "null"]},
        "why_it_matters": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "trace"}}},
          "then": {"required": ["trace_id", "span_name", "duration_ms", "status"]}
        },
        {
          "if": {"properties": {"kind": {"const": "log"}}},
          "then": {"required": ["timestamp", "message"]}
        },
        {
          "if": {"properties": {"kind": {"const": "metric"}}},
          "then": {"required": ["promql", "value", "timestamp"]}
        }
      ]
    }
  }
}
